      "uuid": "11.1.1"
    },
    "jayson": {
      "uuid": "11.1.1",
      "stream-json": "3.7.0"
    },
    "@coral-xyz/anchor": {
      "toml": "5.0.1"
    },
    "@ts-morph/common": {
      "minimatch": "11.0.1"
    },
    "@circle-fin/developer-controlled-wallets": {
      "@solana/codecs-strings": "5.5.1"
    }
  }
